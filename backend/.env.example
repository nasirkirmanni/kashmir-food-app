# Copy to backend/.env for local work. Placeholders only: never commit a real value.

PORT=5000
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-string
CSRF_SECRET=replace-with-another-long-random-string
CLIENT_URL=http://localhost:3000,https://kashmir-food-app.vercel.app

# ── Waza AI (docs/waza-ai/README.md) ─────────────────────────────────────────────
# At least one provider key is needed. Waza uses every provider that has one.
OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# Several keys for one provider: a list, each key named for the account or project it draws on.
# Keys with the same name share one quota; keys with no name are assumed to share one.
# GEMINI_API_KEYS=main=your-key,second-project=your-other-key

# The order models are tried in. Leave unset for the default order for the keys above.
# WAZA_MODELS=gemini:gemini-3.8-flash@low,openrouter:google/gemini-3.8-flash@low,anthropic:claude-haiku-5-5@low

# A ceiling on estimated spend per day (UTC), in US dollars. 0 or unset: no ceiling.
# WAZA_DAILY_BUDGET_USD=2

# Conversations are kept in MongoDB for this many days, then deleted. WAZA_CONVERSATIONS=off keeps none.
# WAZA_CONVERSATION_DAYS=30
# WAZA_CONVERSATIONS=on
