{
  "name": "kashmir-food-finder-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-content-image-manifest.mjs",
    "dev": "next dev --turbo",
    "prebuild": "node scripts/generate-content-image-manifest.mjs && node scripts/check-image-refs.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap-copy": "npx cap copy",
    "cap-sync": "npx cap sync",
    "check:images": "node scripts/check-image-refs.mjs --with-backend"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@next/bundle-analyzer": "^16.2.9",
    "framer-motion": "^12.40.0",
    "jsonrepair": "^3.14.0",
    "lucide-react": "^1.17.0",
    "next": "^14.2.5",
    "nextjs-toploader": "^3.9.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "autoprefixer": "^10.4.19",
    "critters": "^0.0.23",
    "postcss": "^8.4.39",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.7",
    "vitest": "^3.2.6"
  }
}
